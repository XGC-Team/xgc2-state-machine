file(MAKE_DIRECTORY "${BINARY_DIR}")
file(GLOB_RECURSE headers RELATIVE "${INCLUDE_DIR}"
  "${INCLUDE_DIR}/*.h" "${INCLUDE_DIR}/*.hpp" "${INCLUDE_DIR}/*.hh" "${INCLUDE_DIR}/*.hxx")
if(NOT headers)
  message(FATAL_ERROR "Public header inventory is empty")
endif()
set(all_includes "")
foreach(header IN LISTS headers)
  string(REPLACE "/" "_" stem "${header}")
  set(source "${BINARY_DIR}/${stem}.cpp")
  file(WRITE "${source}" "#include <${header}>\n")
  string(APPEND all_includes "#include <${header}>\n")
  execute_process(COMMAND "${COMPILER}" -std=c++17 -pthread "-I${INCLUDE_DIR}"
    -fsyntax-only "${source}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Public header ${header}: ${error}")
  endif()
endforeach()
file(WRITE "${BINARY_DIR}/all.cpp" "${all_includes}")
execute_process(COMMAND "${COMPILER}" -std=c++17 -pthread "-I${INCLUDE_DIR}"
  -fsyntax-only "${BINARY_DIR}/all.cpp" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Combined public headers: ${error}")
endif()
message(STATUS "Standard C++17 public headers: ${headers}")
