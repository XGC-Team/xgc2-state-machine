@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/xgc2_state_machineTargets.cmake")
set(XGC2_STATE_MACHINE_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(XGC2_STATE_MACHINE_LIBRARIES xgc2_state_machine::state_machine)

set(xgc2_state_machine_core_FOUND TRUE)
list(FIND xgc2_state_machine_FIND_COMPONENTS "workers" _xgc2_workers_component)
if(NOT _xgc2_workers_component EQUAL -1)
  include(CMakeFindDependencyMacro)
  find_dependency(Threads)
  include("${CMAKE_CURRENT_LIST_DIR}/xgc2_state_machineWorkersTargets.cmake")
  set(xgc2_state_machine_workers_FOUND TRUE)
endif()
unset(_xgc2_workers_component)
list(FIND xgc2_state_machine_FIND_COMPONENTS "ros1" _xgc2_ros1_component)
list(FIND xgc2_state_machine_FIND_COMPONENTS "ros1_loop" _xgc2_ros1_loop_component)
if(NOT _xgc2_ros1_component EQUAL -1 OR NOT _xgc2_ros1_loop_component EQUAL -1)
  include(CMakeFindDependencyMacro)
  find_dependency(Threads)
  find_dependency(roscpp)
  include("${CMAKE_CURRENT_LIST_DIR}/xgc2_state_machineRos1Targets.cmake")
  set_property(TARGET xgc2_state_machine::ros1 PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES ${roscpp_INCLUDE_DIRS})
  set_property(TARGET xgc2_state_machine::ros1 PROPERTY
    INTERFACE_LINK_LIBRARIES xgc2_state_machine::state_machine Threads::Threads ${roscpp_LIBRARIES})
  set(xgc2_state_machine_ros1_FOUND TRUE)
endif()
if(NOT _xgc2_ros1_loop_component EQUAL -1)
  find_dependency(rosgraph_msgs)
  include("${CMAKE_CURRENT_LIST_DIR}/xgc2_state_machineRos1LoopTargets.cmake")
  set_property(TARGET xgc2_state_machine::ros1_loop PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES ${rosgraph_msgs_INCLUDE_DIRS})
  set(xgc2_state_machine_ros1_loop_FOUND TRUE)
endif()
unset(_xgc2_ros1_component)
unset(_xgc2_ros1_loop_component)
check_required_components(xgc2_state_machine)
